TAXLEDGER_DATABASE_URL=postgresql+psycopg://taxledger:change-me@postgres:5432/taxledger
TAXLEDGER_ENV=production
TAXLEDGER_AUTH_MODE=oidc
TAXLEDGER_JWT_ISSUER=https://identity.example.com
TAXLEDGER_JWT_AUDIENCE=taxledger-api
TAXLEDGER_OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
# Controlled pilot exception only: set AUTH_MODE=hmac, a 32+ character secret and ALLOW_HMAC_PRODUCTION=true.
TAXLEDGER_JWT_SECRET=
TAXLEDGER_ALLOW_HMAC_PRODUCTION=false
TAXLEDGER_AUTO_CREATE_SCHEMA=false
TAXLEDGER_BACKUP_KEY_BASE64=replace-with-a-base64-encoded-32-byte-key
